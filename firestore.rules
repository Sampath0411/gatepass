rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/gp_events/$(eventId)).data;
    }

    function isOwner(eventId) {
      return signedIn() && eventData(eventId).ownerId == request.auth.uid;
    }

    function passMatches(token, passId, eventId) {
      return token is string
        && get(/databases/$(database)/documents/gp_passes/$(token)).data.id == passId
        && get(/databases/$(database)/documents/gp_passes/$(token)).data.eventId == eventId;
    }

    // Organiser's event list index — scoped by uid so no query rules are needed.
    match /gp_users/{uid}/events/{eventId} {
      allow read, create, update, delete: if signedIn() && uid == request.auth.uid;
    }

    match /gp_events/{eventId} {
      allow get: if isOwner(eventId);
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(eventId);
    }

    match /gp_events/{eventId}/passes/{passId} {
      allow read, create, update, delete: if isOwner(eventId);
    }

    // The code in the path is the capability; no client can enumerate codes.
    match /gp_gates/{code} {
      allow get: if exists(/databases/$(database)/documents/gp_gates/$(code));
      allow list: if false;
      allow create: if signedIn()
        && (
          (existsAfter(/databases/$(database)/documents/gp_events/$(request.resource.data.eventId))
            && getAfter(/databases/$(database)/documents/gp_events/$(request.resource.data.eventId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/gp_events/$(request.resource.data.eventId)).data.gateCode == code)
          ||
          (exists(/databases/$(database)/documents/gp_events/$(request.resource.data.eventId))
            && get(/databases/$(database)/documents/gp_events/$(request.resource.data.eventId)).data.ownerId == request.auth.uid)
        );
      // Phase A: sub-event gates are keyed by a fest + sub-event, not gp_events.
      // The sub-event doc is created in the same batch (so existsAfter/getAfter);
      // isFestOwnerAfter also covers a fest created in that same batch.
      allow create: if signedIn()
        && request.resource.data.festId is string
        && existsAfter(/databases/$(database)/documents/gp_fests/$(request.resource.data.festId)/events/$(request.resource.data.eventId))
        && getAfter(/databases/$(database)/documents/gp_fests/$(request.resource.data.festId)/events/$(request.resource.data.eventId)).data.gateCode == code
        && isFestOwnerAfter(request.resource.data.festId);
      // V2 events: the gate is written in the same batch as its event, so both
      // the owner check and the gate-code binding come from the after-state.
      allow create: if signedIn()
        && existsAfter(/databases/$(database)/documents/gp_events_v2/$(request.resource.data.eventId))
        && getAfter(/databases/$(database)/documents/gp_events_v2/$(request.resource.data.eventId)).data.gateCode == code
        && getAfter(/databases/$(database)/documents/gp_events_v2/$(request.resource.data.eventId)).data.ownerId == request.auth.uid;
      allow delete: if isOwner(resource.data.eventId)
        || (resource.data.festId is string && isFestOwner(resource.data.festId));
      allow update: if isOwner(resource.data.eventId)
        || (resource.data.eventId == request.resource.data.eventId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['checked', 'bounced', 'recent']))
        || (resource.data.festId is string && isFestOwner(resource.data.festId));
      // Second grants for v2 events. isOwner() cannot be used here: the v2
      // gate's eventId points at gp_events_v2, not gp_events.
      allow delete: if isOwnerEventV2(resource.data.eventId)
        && get(/databases/$(database)/documents/gp_events_v2/$(resource.data.eventId)).data.gateCode == code;
      allow update: if isOwnerEventV2(request.resource.data.eventId)
        && get(/databases/$(database)/documents/gp_events_v2/$(request.resource.data.eventId)).data.gateCode == code;
      // A member issuing their own pass on a non-approval event increments the
      // gate total in the batch that creates their own approved RSVP. Tightly
      // scoped to a single 'total' mutation plus an approved own RSVP.
      allow update: if signedIn()
        && get(/databases/$(database)/documents/gp_events_v2/$(resource.data.eventId)).data.gateCode == code
        && get(/databases/$(database)/documents/gp_events_v2/$(resource.data.eventId)).data.get('approval', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total'])
        && getAfter(/databases/$(database)/documents/gp_rsvps/$(resource.data.eventId)/rsvps/$(request.auth.uid)).data.status == 'approved';
    }

    match /gp_gates/{code}/roster/{passId} {
      // SECURITY (21 Nov 2026): roster reads stay code-gated because Find-by-name
      // needs them, but the roster still stores the raw pass token — a code-holder
      // calling the Firestore API directly can read it. That is a residual risk:
      // only a Cloud Function (server-side scan) can fully hide the token.
      // The client no longer returns or renders the token from gate search.
      allow read: if exists(/databases/$(database)/documents/gp_gates/$(code));
      allow create: if isOwner(
        get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId)
        || (signedIn() && get(/databases/$(database)/documents/gp_reg_public/$(get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId)).data.gateCode == code);
      allow delete: if isOwner(
        get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId);
      // Second grants for v2 gates: eventId resolves to a gp_events_v2 doc,
      // so isOwner() (which looks up gp_events) cannot be used.
      allow create: if isOwnerEventV2(
        get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId);
      // A member issuing their own pass creates only their own roster row.
      allow create: if signedIn()
        && passId == request.auth.uid
        && get(/databases/$(database)/documents/gp_events_v2/$(get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId)).data.gateCode == code
        && get(/databases/$(database)/documents/gp_events_v2/$(get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId)).data.get('approval', false) == false;
      allow delete: if isOwnerEventV2(
        get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId);
      // Owner-only update. The scan transaction no longer writes the roster
      // stamp: checked-in state is derived from the one-shot claim doc instead.
      // A direct stamp write used to let anyone fake a check-in; it is closed.
      allow update: if isOwner(get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId);
    }

    // Attendee pass: the 32-char token is the doc ID and the capability.
    match /gp_passes/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isOwner(request.resource.data.eventId);
      // Phase A: a signed-in student creates their own public pass doc during
      // registration. Firestore ORs the two create grants.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id','festId','eventId','event','name','checkedInAt','gate']);
      // V2 owner issuing a pass on approval. The signed-in grant above still
      // covers a member issuing their own pass on a non-approval event.
      allow create: if signedIn()
        && isOwnerEventV2(request.resource.data.eventId)
        && request.resource.data.keys().hasOnly(['id','festId','eventId','event','name','checkedInAt','gate']);
      // SECURITY (21 Nov 2026): owner-only update. The old rule let any
      // token-holder flip checkedInAt/gate on their own pass, faking a
      // check-in on the pass page. The scan transaction no longer writes
      // this stamp either — the one-shot claim doc is the only authority
      // for "checked in". The pass page therefore no longer shows an
      // "Already used" stamp from scans; the gate still blocks repeats.
      allow update: if isOwner(resource.data.eventId);
      allow delete: if isOwner(resource.data.eventId);
    }

    // The one-shot claim lives under the gate code: the code is the read capability,
    // so no gate code is ever stored in a document an attendee could read.
    match /gp_gates/{code}/claims/{passId} {
      allow read: if exists(/databases/$(database)/documents/gp_gates/$(code));
      allow create: if !exists(/databases/$(database)/documents/gp_gates/$(code)/claims/$(passId))
        && get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId == request.resource.data.eventId
        && passMatches(request.resource.data.token, passId, request.resource.data.eventId)
        && (isOwner(request.resource.data.eventId) || request.resource.data.scannedAt == request.time)
        && request.resource.data.keys().hasOnly(['eventId', 'token', 'name', 'gate', 'device', 'scannedAt'])
        && request.resource.data.keys().hasAll(['eventId', 'token', 'name', 'gate', 'device', 'scannedAt']);
      allow update: if isOwner(get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId);
      allow delete: if isOwner(get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId);
    }

    match /gp_gates/{code}/claims/{passId}/repeats/{rid} {
      allow read: if exists(/databases/$(database)/documents/gp_gates/$(code));
      allow create: if get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId == request.resource.data.eventId
        && (isOwner(request.resource.data.eventId) || request.resource.data.scannedAt == request.time)
        && request.resource.data.keys().hasOnly(['eventId', 'gate', 'device', 'scannedAt'])
        && request.resource.data.keys().hasAll(['eventId', 'gate', 'device', 'scannedAt']);
      allow update: if isOwner(get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId);
      allow delete: if isOwner(get(/databases/$(database)/documents/gp_gates/$(code)).data.eventId);
    }

    // ── Phase A: fests, sub-events, public registration ──
    function isFestOwner(festId) {
      return signedIn() && get(/databases/$(database)/documents/gp_fests/$(festId)).data.ownerId == request.auth.uid;
    }
    // Create-only variant: a fest may be created in the same batch as its first
    // sub-event/gate, so the fest doc must be read from the after-state. Kept
    // separate so read/update/delete still use the pre-write state.
    function isFestOwnerAfter(festId) {
      return signedIn() && getAfter(/databases/$(database)/documents/gp_fests/$(festId)).data.ownerId == request.auth.uid;
    }
    function isSubEventOwner(festId, eventId) {
      return isFestOwner(festId)
        && exists(/databases/$(database)/documents/gp_fests/$(festId)/events/$(eventId));
    }

    match /gp_fests/{festId} {
      allow get, update, delete: if isFestOwner(festId);
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
    }
    match /gp_users/{uid}/fests/{festId} {
      allow read, create, update, delete: if signedIn() && uid == request.auth.uid;
    }
    match /gp_fests/{festId}/events/{eventId} {
      allow read, update, delete: if isFestOwner(festId);
      allow create: if isFestOwnerAfter(festId);
    }
    match /gp_reg_public/{eventId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isFestOwner(request.resource.data.festId);
      allow update, delete: if isFestOwner(resource.data.festId);
    }

    // A student may create exactly one pass of their own for an open event.
    match /gp_fests/{festId}/events/{eventId}/passes/{passId} {
      allow read: if isFestOwner(festId);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/gp_reg_public/$(eventId)).data.registrationOpen == true
        && request.resource.data.keys().hasOnly(['name','contact','token','uid','registrationId','createdAt','checkedInAt','gate']);
      allow update, delete: if isFestOwner(festId);
    }
    match /gp_fests/{festId}/registrations/{regId} {
      allow read, update, delete: if isFestOwner(festId);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['eventId','eventName','festId','name','email','phone','uid','passId','token','createdAt','sheetSynced']);
    }

    // ── Luma-style events v2 + RSVPs ──
    function isOwnerEventV2(eventId) {
      return signedIn()
        && get(/databases/$(database)/documents/gp_events_v2/$(eventId)).data.ownerId == request.auth.uid;
    }
    function isApprovalEventV2(eventId) {
      return get(/databases/$(database)/documents/gp_events_v2/$(eventId)).data.get('approval', false) == true;
    }
    // Approval state is a host capability: a member may edit their own details
    // (and resubmit a rejected request back to 'pending'), but may never set
    // themselves to 'approved' or write the pass/review fields.
    function memberCreateApprovalOk(eventId) {
      return !isApprovalEventV2(eventId)
        || (request.resource.data.get('status', 'pending') != 'approved'
            && !request.resource.data.keys().hasAny(['passToken', 'reviewedAt', 'reviewedBy']));
    }
    function memberUpdateApprovalOk(eventId) {
      return !isApprovalEventV2(eventId)
        || !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['status', 'passToken', 'reviewedAt', 'reviewedBy'])
        || (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['passToken', 'reviewedAt', 'reviewedBy'])
            && request.resource.data.get('status', 'pending') == 'pending');
    }

    match /gp_events_v2/{eventId} {
      // Link-only private events: the long unguessable URL is the capability,
      // so any signed-in user with the link can open the event. List queries
      // stay public-only (owners use the createdEvents index below).
      allow get: if resource.data.visibility == 'public' || signedIn();
      // Rules are NOT filters: public list queries must carry
      // where("visibility","==","public"). Owner lists use the
      // gp_users/{uid}/createdEvents index below instead of querying this path.
      allow list: if resource.data.visibility == 'public' || isOwnerEventV2(eventId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwnerEventV2(eventId);
    }

    // Owner-scoped index for private events — written in the same batch as the event.
    match /gp_users/{uid}/createdEvents/{eventId} {
      allow read, create, update, delete: if signedIn() && uid == request.auth.uid;
    }

    // NOTE: a Firestore document path needs an even number of segments, so the
    // plan's gp_rsvps/{eventId}/{uid} is not a valid doc path. Use the rsvps
    // subcollection level; {uid} remains the RSVP doc id.
    match /gp_rsvps/{eventId}/rsvps/{uid} {
      // A link-holder is signed in, so link-only private events' RSVPs are
      // readable by any signed-in user; public events stay readable by all.
      allow read: if get(/databases/$(database)/documents/gp_events_v2/$(eventId)).data.visibility == 'public'
        || signedIn()
        || isOwnerEventV2(eventId);
      // Only the member themselves may create an RSVP. Once created, either the
      // event owner (member directory edits) or the member (own details) may
      // update/delete it.
      allow create: if signedIn() && uid == request.auth.uid && memberCreateApprovalOk(eventId);
      allow update: if isOwnerEventV2(eventId)
        || (signedIn() && uid == request.auth.uid && memberUpdateApprovalOk(eventId));
      allow delete: if isOwnerEventV2(eventId) || (signedIn() && uid == request.auth.uid);
    }
  }
}
